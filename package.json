{
  "name": "nob-hill-chile-drop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/prepare-assets.mjs && bundle exec jekyll build && node shared/dust-wave-platform/packages/build-core/bin/minify-site-assets.mjs --site-dir _site --write",
    "dev": "npm run build && node scripts/serve.mjs",
    "test": "npm run test:content && npm --prefix api test && npm run build && playwright test",
    "test:content": "node --test tests/content.test.mjs",
    "test:browser": "playwright test",
    "api:check": "wrangler deploy --dry-run --config api/wrangler.toml --outdir work/worker",
    "social:render": "node scripts/render-social.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.1",
    "wrangler": "4.154.0",
    "yaml": "2.9.0"
  }
}
